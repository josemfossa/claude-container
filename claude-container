#!/bin/bash

set -euo pipefail
trap 'exit 1' INT

BUILD=0
RISKY=0
SSH_AGENT_FWD=0
ALLOWLIST=0
IMAGE=""
IMAGE_NAME="localhost/claude-container_claude-auth-workspace"

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" > /dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" > /dev/null 2>&1 && pwd)"

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] <directory>

Launch a containerized Claude workspace in the given directory.

Options:
  -b, --build       Force a rebuild of the container image
  -h, --help        Show this help message and exit
  -i, --image NAME  Use the given container image instead of building one
  --ssh-agent       Forward the host SSH agent (\$SSH_AUTH_SOCK) into the container
  --risky           Allow launching when .claude_mounts.yaml is not ignored
  --allowlist       Mount only the paths .claudeignore lets through, one by one.
                    The default mounts the whole directory and hides the ignored
                    paths on top of it (see below)

Files:
  .claudeignore      Patterns of files/directories to exclude from the container
                     (format similar to .gitignore)
  .claude_mounts.yaml  Optional compose override for extra volume mounts
  .claude_start.sh    Optional script run in the container instead of claude
                       (mounted read-only, always excluded from workspace)

Mounts:
  By default the directory is mounted as a whole, so files replaced on the host
  (editor saves, git checkout/stash, ...) show up in the container and the other
  way around. The ignored paths are hidden on top of it: directories with an
  empty tmpfs, files with /dev/null. This hides what exists at launch: an ignored
  file created later, in a directory that is visible, is not hidden.

  With --allowlist every visible path is mounted on its own, so nothing new is
  ever visible. The price is that a file replaced on the host (new inode) is
  not seen by the container anymore until it is relaunched.

Checkpointing:
  To save the current container state as an image, find the running container
  and commit it:

    podman ps
    podman commit <container-name> my-checkpoint

  Then resume it later with:

    claude-container --image my-checkpoint <directory>
EOF
}

# What to mount or to hide, from .claudeignore. One "KIND<TAB>path" per line:
#   M  bind mount the path (--allowlist: minimal spanning set of what is visible)
#   D  hide the directory with an empty tmpfs (default)
#   F  hide the file with /dev/null (default)
generate_volume_mounts() {
  local work_dir=$1
  local claudeignore="$work_dir/.claudeignore"

  if ! command -v fdfind >/dev/null 2>&1; then
    echo "Error: fdfind is required" >&2
    return 1
  fi

  if [[ ! -d "$work_dir" ]]; then
    echo "Error: not a directory: $work_dir" >&2
    return 1
  fi

  if [[ ! -f "$claudeignore" ]]; then
    echo "Error: .claudeignore not found: $claudeignore" >&2
    return 1
  fi

  local mode=mask
  if [[ $ALLOWLIST -eq 1 ]]; then
    mode=allowlist
  fi

  # .claude_start.sh is mounted separately and read-only. With --allowlist it
  # must not be part of the workspace mounts. By default it is a read-only
  # mount on top of the whole directory, so it must not be hidden either.
  local tmp_ignore
  tmp_ignore="$(mktemp)"
  cat "$claudeignore" > "$tmp_ignore"
  if [[ $ALLOWLIST -eq 1 ]]; then
    echo ".claude_start.sh" >> "$tmp_ignore"
  fi

  local status=0
  MODE="$mode" WORK_DIR="$work_dir" CLAUDEIGNORE="$tmp_ignore" python3 "${SCRIPT_DIR}/fd_helper.py" || status=$?
  rm -f "$tmp_ignore"
  return $status
}

# Generate compose override file with selective volume mounts
generate_compose_override() {
  local work_dir=$1
  local mounts=$2
  local claudeignore="$work_dir/.claudeignore"

  if [[ ! -f "$claudeignore" ]]; then
    echo "Error: .claudeignore not found: $claudeignore" >&2
    return 1
  fi

  mkdir -p "${work_dir}/.claude"

  local override_file
  override_file="$(mktemp -d)/compose.override.yml"

  local mounts_yaml=""
  local tmpfs_yaml=""
  if [[ $ALLOWLIST -eq 0 ]]; then
    # The whole directory, the ignored paths are hidden on top of it
    mounts_yaml+="      - \${CONTEXT}:/workspace"$'\n'
  fi
  while IFS=$'\t' read -r kind mount_path; do
    if [[ -z "$mount_path" ]]; then
      continue
    fi
    case "$kind" in
      M) mounts_yaml+="      - \${CONTEXT}/$mount_path:/workspace/$mount_path"$'\n' ;;
      F) mounts_yaml+="      - /dev/null:/workspace/$mount_path:ro"$'\n' ;;
      D) tmpfs_yaml+="      - /workspace/$mount_path"$'\n' ;;
    esac
  done <<< "$mounts"

  local tmpfs_block=""
  if [[ -n "$tmpfs_yaml" ]]; then
    tmpfs_block="    tmpfs:"$'\n'"${tmpfs_yaml}"
  fi

  # Mount .claude_start.sh read-only and run it instead of claude
  local start_mount=""
  local start_command=""
  if [[ -f "$work_dir/.claude_start.sh" ]]; then
    start_mount="      - \${CONTEXT}/.claude_start.sh:/workspace/.claude_start.sh:ro"$'\n'
    start_command="    command: bash /workspace/.claude_start.sh"$'\n'
  fi

  # Optionally forward the host SSH agent
  local ssh_mount=""
  local ssh_extra=""
  if [[ $SSH_AGENT_FWD -eq 1 ]]; then
    if [[ -z "${SSH_AUTH_SOCK:-}" || ! -S "$SSH_AUTH_SOCK" ]]; then
      echo "Error: --ssh-agent given but SSH_AUTH_SOCK is unset or not a socket" >&2
      return 1
    fi
    ssh_mount="      - ${SSH_AUTH_SOCK}:/run/ssh-agent.sock"$'\n'
    ssh_extra="    environment:
      SSH_AUTH_SOCK: /run/ssh-agent.sock
    security_opt:
      - label=disable
"
  fi

  # Always include config mounts
  cat > "$override_file" <<EOF
services:
  claude-auth-workspace:
    volumes:
      - \${CLAUDE_CONFIG_DIR:-~}/.claude.json:/home/node/.claude.json
      - \${CLAUDE_CONFIG_DIR:-~}/.claude:/home/node/.claude
      - \${CLAUDE_CONFIG_DIR:-~}/.claudeconfig:/home/node/.config/anthropic/
      - \${AVEN_DB_DIR:-~/.local/state/aven/}:/home/node/.local/state/aven/
${mounts_yaml}${ssh_mount}${start_mount}${tmpfs_block}${ssh_extra}${start_command}
EOF

  echo "${override_file}"
}

# Return 0 if .claude_mounts.yaml would be exposed inside the container.
# Default: it is exposed unless it is hidden. --allowlist: it is exposed when
# the whole workdir (.) or the file itself is mounted.
is_exposed() {
  local mounts=$1
  if [[ $ALLOWLIST -eq 1 ]]; then
    awk -F'\t' '$2 == "." || $2 == ".claude_mounts.yaml" { found = 1 } END { exit !found }' <<< "$mounts"
  else
    ! grep -qxF $'F\t.claude_mounts.yaml' <<< "$mounts"
  fi
}

# Generate compose override to use a specific image instead of building
generate_image_override() {
  local image=$1
  local override_file
  override_file="$(mktemp -d)/compose.image.yml"
  cat > "$override_file" <<EOF
services:
  claude-auth-workspace:
    image: ${image}
EOF
  echo "${override_file}"
}

# Parse arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--build)
      BUILD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --risky)
      RISKY=1
      shift
      ;;
    --ssh-agent)
      SSH_AGENT_FWD=1
      shift
      ;;
    --allowlist)
      ALLOWLIST=1
      shift
      ;;
    -i|--image)
      if [[ $# -lt 2 ]]; then
        echo "Error: --image requires an argument" >&2
        exit 1
      fi
      IMAGE="$2"
      shift 2
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- ${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

RUN_DIR="$( cd "$(dirname "$( readlink "$0" || ls -1 "$0" )")" > /dev/null && pwd -P )"
echo "RUN DIR: $RUN_DIR"

WORKING_DIR=$( cd "$1" > /dev/null && pwd )
cd "$WORKING_DIR" || exit 1

touch "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"

# Generate compose override with selective mounts
MOUNTS=$(generate_volume_mounts "$WORKING_DIR") || exit 1
OVERRIDE_FILE=$(generate_compose_override "$WORKING_DIR" "$MOUNTS") || exit 1

# Compose files: base + optional override
COMPOSE_FILES=("-f" "$RUN_DIR/compose.yml" "-f" "$OVERRIDE_FILE")

# Add per-project extra mounts if .claude_mounts.yaml exists
MOUNTS_FILE="$WORKING_DIR/.claude_mounts.yaml"
if [[ -f "$MOUNTS_FILE" ]]; then
  if is_exposed "$MOUNTS"; then
    if [[ $RISKY -eq 0 ]]; then
      echo "Error: .claude_mounts.yaml is not ignored by .claudeignore." >&2
      echo "It defines container mounts and, if visible inside the container," >&2
      echo "can be trivially modified to escape the container." >&2
      echo "Add it to .claudeignore or pass --risky to proceed." >&2
      exit 1
    fi
    echo "Warning: .claude_mounts.yaml is not in .claudeignore (--risky given)." >&2
  fi
  COMPOSE_FILES+=("-f" "$MOUNTS_FILE")
fi

# Use a specific image instead of building
IMAGE_OVERRIDE=""
if [[ -n "$IMAGE" ]]; then
  if [[ $BUILD -eq 1 ]]; then
    echo "Error: --build and --image are mutually exclusive" >&2
    exit 1
  fi
  IMAGE_OVERRIDE=$(generate_image_override "$IMAGE")
  COMPOSE_FILES+=("-f" "$IMAGE_OVERRIDE")
fi

if [[ $BUILD -eq 1 ]]; then
  CONTEXT="$WORKING_DIR" CLAUDE_CONTAINER_DIR="$RUN_DIR" CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME}" podman compose "${COMPOSE_FILES[@]}" --in-pod false run --rm --build claude-auth-workspace
else
  CONTEXT="$WORKING_DIR" CLAUDE_CONTAINER_DIR="$RUN_DIR" CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME}" podman compose "${COMPOSE_FILES[@]}" --in-pod false run --rm claude-auth-workspace
fi

rm -f "$OVERRIDE_FILE"
if [[ -n "$IMAGE_OVERRIDE" ]]; then
  rm -f "$IMAGE_OVERRIDE"
fi
exit 0
