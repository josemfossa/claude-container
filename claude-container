#!/bin/bash

set -euo pipefail
trap 'exit 1' INT

BUILD=0
IMAGE_NAME="localhost/claude-container_claude-auth-workspace"

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" > /dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" > /dev/null 2>&1 && pwd)"

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] <directory>

Launch a containerized Claude workspace in the given directory.

Options:
  -b, --build    Force a rebuild of the container image
  -h, --help     Show this help message and exit

Files:
  .claudeignore  Patterns of files/directories to exclude from the container
                 (format similar to .gitignore)
EOF
}

# Generate volume mounts from .claudeignore, computing minimal spanning set
generate_volume_mounts() {
  local work_dir=$1
  local claudeignore="$work_dir/.claudeignore"

  if ! command -v fdfind >/dev/null 2>&1; then
    echo "Error: fdfind is required" >&2
    return 1
  fi

  if [[ ! -d "$work_dir" ]]; then
    echo "Error: not a directory: $work_dir" >&2
    return 1
  fi

  if [[ ! -f "$claudeignore" ]]; then
    return 0
  fi

  WORK_DIR="$work_dir" CLAUDEIGNORE="$claudeignore" python3 "${SCRIPT_DIR}/fd_helper.py" || return 1
}

# Generate compose override file with selective volume mounts
generate_compose_override() {
  local work_dir=$1
  local claudeignore="$work_dir/.claudeignore"

  local override_dir
  override_dir=$(mktemp -d) || return 1
  local override_file="$override_dir/compose.override.yml"

  if [[ ! -f "$claudeignore" ]]; then
    echo "Error: .claudeignore not found: $claudeignore" >&2
    rm -rf "$override_dir"
    return 1
  fi

  # Get minimal mount set
  local mounts_output
  mounts_output=$(generate_volume_mounts "$work_dir") || return 1

  local mounts_yaml=""
  while IFS= read -r mount_path; do
    if [[ -n "$mount_path" ]]; then
      mounts_yaml+="      - \${CONTEXT}/$mount_path:/workspace/$mount_path"$'\n'
    fi
  done <<< "$mounts_output"

  # Always include config mounts
  cat > "$override_file" <<EOF
services:
  claude-auth-workspace:
    volumes:
      - \${CLAUDE_CONFIG_DIR:-~}/.claude.json:/home/node/.claude.json
      - \${CLAUDE_CONFIG_DIR:-~}/.claude:/home/node/.claude
      - \${CLAUDE_CONFIG_DIR:-~}/.claudeconfig:/home/node/.config/anthropic/
${mounts_yaml}
EOF

  echo "${override_file}"
}

# Parse arguments
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--build)
      BUILD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- ${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

RUN_DIR="$( cd "$(dirname "$( readlink "$0" || ls -1 "$0" )")" > /dev/null && pwd -P )"
echo "RUN DIR: $RUN_DIR"

WORKING_DIR=$( cd "$1" > /dev/null && pwd )
cd "$WORKING_DIR" || exit 1

touch "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"

# Generate compose override with selective mounts if .claudeignore exists
OVERRIDE_FILE=$(generate_compose_override "$WORKING_DIR") || exit 1

# Compose files: base + optional override
COMPOSE_FILES=("-f" "$RUN_DIR/compose.yml" "-f" "$OVERRIDE_FILE")

if [[ $BUILD -eq 1 ]]; then
  CONTEXT="$WORKING_DIR" CLAUDE_CONTAINER_DIR="$RUN_DIR" CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME}" podman compose "${COMPOSE_FILES[@]}" --in-pod false run --rm --build claude-auth-workspace
else
  CONTEXT="$WORKING_DIR" CLAUDE_CONTAINER_DIR="$RUN_DIR" CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME}" podman compose "${COMPOSE_FILES[@]}" --in-pod false run --rm claude-auth-workspace
fi

rm -rf "$(dirname "$OVERRIDE_FILE")"
